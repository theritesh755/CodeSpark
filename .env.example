APP_NAME=CryptoTrace
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL is the source of truth
DATABASE_URL=postgresql+psycopg://cryptotrace:cryptotrace_dev@localhost:5432/cryptotrace

# Optional supporting services
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://cryptotrace:cryptotrace_dev@localhost:5672/
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cryptotrace_dev_password

# Free/public data sources. Blockstream Esplora works without an API key.
BLOCKSTREAM_BASE_URL=https://blockstream.info/api
# EVM RPC URLs: use free provider endpoints from your provider dashboard.
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
# Optional Etherscan-compatible API keys (not required for sample mode)
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# Runtime behaviour
DATA_MODE=sample
HTTP_TIMEOUT_SECONDS=15
MAX_TRACE_HOPS=5
MAX_TRANSACTIONS_PER_ADDRESS=50
RISK_HIGH_THRESHOLD=70
LOG_LEVEL=INFO
